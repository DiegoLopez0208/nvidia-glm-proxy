{
  "name": "nvidia-glm-proxy",
  "version": "1.1.0",
  "description": "Proxy for NVIDIA NIM API that fixes GLM-5.1 tool_call streaming bugs (numeric IDs, missing function.name, ID instability). Auto-routes vision requests (image_url) to Llama 3.2 90B Vision.",
  "main": "proxy.js",
  "bin": {
    "nvidia-glm-proxy": "./proxy.js"
  },
  "scripts": {
    "start": "node proxy.js"
  },
  "keywords": [
    "nvidia",
    "nim",
    "glm",
    "proxy",
    "tool-calls",
    "streaming",
    "openai-compatible",
    "mcp",
    "vision",
    "llama-3.2"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/DiegoLopez0208/nvidia-glm-proxy.git"
  },
  "files": [
    "proxy.js",
    ".env.example",
    "install.sh",
    "install.ps1",
    "ecosystem.config.js",
    "nvidia-glm-proxy.service",
    "uninstall.ps1",
    "LICENSE"
  ],
  "dependencies": {}
}
